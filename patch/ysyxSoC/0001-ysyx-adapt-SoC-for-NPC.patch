diff --git a/perip/gpio/gpio_top_apb.v b/perip/gpio/gpio_top_apb.v
index ec51ffe5..b2366113 100644
--- a/perip/gpio/gpio_top_apb.v
+++ b/perip/gpio/gpio_top_apb.v
@@ -1,3 +1,15 @@
+//-----------------------------------------------------------------
+// GPIO Controller (APB slave)
+//
+// Register map:
+//   0x0: LED output (16-bit write)  → gpio_out[15:0]
+//   0x4: Switch input (16-bit read) → gpio_in[15:0]
+//   0x8: 7-segment (32-bit write)   → {seg7,...,seg0}, 4-bit hex per digit
+//   0xc: reserved
+//
+// 7-segment decoding: 4-bit hex → 8-bit segment pattern (active low)
+//-----------------------------------------------------------------
+
 module gpio_top_apb(
   input         clock,
   input         reset,
@@ -24,4 +36,90 @@ module gpio_top_apb(
   output [7:0]  gpio_seg_7
 );
 
+  // APB: always ready, no errors
+  assign in_pready  = 1'b1;
+  assign in_pslverr = 1'b0;
+
+  //-----------------------------------------------------------------
+  // Registers
+  //-----------------------------------------------------------------
+  reg [15:0] led_reg;      // offset 0x0
+  reg [31:0] seg_reg;      // offset 0x8 (4 bits × 8 digits)
+
+  assign gpio_out = led_reg;
+
+  //-----------------------------------------------------------------
+  // APB read
+  //-----------------------------------------------------------------
+  wire apb_read  = in_psel && in_penable && !in_pwrite;
+  wire apb_write = in_psel && in_penable &&  in_pwrite;
+
+  reg [31:0] rdata;
+  assign in_prdata = rdata;
+
+  always @(*) begin
+    rdata = 32'd0;
+    if (apb_read) begin
+      case (in_paddr[3:0])
+        4'h0: rdata = {16'd0, led_reg};
+        4'h4: rdata = {16'd0, gpio_in};
+        4'h8: rdata = seg_reg;
+        default: rdata = 32'd0;
+      endcase
+    end
+  end
+
+  //-----------------------------------------------------------------
+  // APB write
+  //-----------------------------------------------------------------
+  always @(posedge clock) begin
+    if (reset) begin
+      led_reg <= 16'd0;
+      seg_reg <= 32'd0;
+    end else if (apb_write) begin
+      case (in_paddr[3:0])
+        4'h0: led_reg <= in_pwdata[15:0];
+        4'h8: seg_reg <= in_pwdata;
+        default: ;
+      endcase
+    end
+  end
+
+  //-----------------------------------------------------------------
+  // 7-segment decoder: 4-bit hex → 8-bit segment (NVBoard: 0=on, 1=off)
+  // Segment bits: {A, B, C, D, E, F, G, DP}
+  //-----------------------------------------------------------------
+  function [7:0] hex2seg;
+    input [3:0] hex;
+    begin
+      case (hex)
+        4'h0: hex2seg = 8'b00000011;  // "0"
+        4'h1: hex2seg = 8'b10011111;  // "1"
+        4'h2: hex2seg = 8'b00100101;  // "2"
+        4'h3: hex2seg = 8'b00001101;  // "3"
+        4'h4: hex2seg = 8'b10011001;  // "4"
+        4'h5: hex2seg = 8'b01001001;  // "5"
+        4'h6: hex2seg = 8'b01000001;  // "6"
+        4'h7: hex2seg = 8'b00011111;  // "7"
+        4'h8: hex2seg = 8'b00000001;  // "8"
+        4'h9: hex2seg = 8'b00001001;  // "9"
+        4'ha: hex2seg = 8'b00010001;  // "A"
+        4'hb: hex2seg = 8'b11000001;  // "b"
+        4'hc: hex2seg = 8'b01100011;  // "C"
+        4'hd: hex2seg = 8'b10000101;  // "d"
+        4'he: hex2seg = 8'b01100001;  // "E"
+        4'hf: hex2seg = 8'b01110001;  // "F"
+      endcase
+    end
+  endfunction
+
+  assign gpio_seg_0 = hex2seg(seg_reg[3:0]);
+  assign gpio_seg_1 = hex2seg(seg_reg[7:4]);
+  assign gpio_seg_2 = hex2seg(seg_reg[11:8]);
+  assign gpio_seg_3 = hex2seg(seg_reg[15:12]);
+  assign gpio_seg_4 = hex2seg(seg_reg[19:16]);
+  assign gpio_seg_5 = hex2seg(seg_reg[23:20]);
+  assign gpio_seg_6 = hex2seg(seg_reg[27:24]);
+  assign gpio_seg_7 = hex2seg(seg_reg[31:28]);
+
 endmodule
diff --git a/perip/ps2/ps2_top_apb.v b/perip/ps2/ps2_top_apb.v
index 080d38fa..cb6e75c5 100644
--- a/perip/ps2/ps2_top_apb.v
+++ b/perip/ps2/ps2_top_apb.v
@@ -1,3 +1,14 @@
+//-----------------------------------------------------------------
+// PS2 Keyboard Controller (APB slave) — with 8-deep FIFO
+//
+// Register 0x0: 8-bit scan code (read), 0 if FIFO empty
+//
+// PS2 frame: start(0)+8data(LSB)+parity(odd)+stop(1), 11 bits
+// Sampled on falling edge of PS2_CLK.
+// Parity-checked; invalid frames are discarded.
+// FIFO prevents data loss when CPU doesn't read immediately.
+//-----------------------------------------------------------------
+
 module ps2_top_apb(
   input         clock,
   input         reset,
@@ -16,4 +27,60 @@ module ps2_top_apb(
   input         ps2_data
 );
 
+  assign in_pready  = 1'b1;
+  assign in_pslverr = 1'b0;
+
+
+  reg [2:0] ps2_clk_sync;
+  wire      sampling = ps2_clk_sync[2] & ~ps2_clk_sync[1];
+
+  always @(posedge clock) begin
+    if (reset) ps2_clk_sync <= 3'b000;
+    else       ps2_clk_sync <= {ps2_clk_sync[1:0], ps2_clk};
+  end
+
+  reg [9:0]  buffer;     
+  reg [3:0]  count;     
+
+  always @(posedge clock) begin
+    if (reset) begin
+      count  <= 4'd0;
+      buffer <= 10'd0;
+    end else if (sampling) begin
+      if (count == 4'd10) begin
+        if ((buffer[0] == 1'b0) &&          
+            (ps2_data == 1'b1) &&           
+            (^buffer[9:1] == 1'b1)) begin  
+          fifo[w_ptr] <= buffer[8:1];
+          w_ptr       <= w_ptr + 3'd1;
+          overflow    <= overflow | ((w_ptr + 3'd1) == r_ptr);
+        end
+        count <= 4'd0;  
+      end else begin
+        buffer[count] <= ps2_data;
+        count <= count + 4'd1;
+      end
+    end
+  end
+
+  reg [7:0]  fifo[7:0];
+  reg [2:0]  w_ptr, r_ptr;
+  reg        overflow;
+
+  wire fifo_empty = (w_ptr == r_ptr);
+  wire apb_rd    = in_psel && in_penable && !in_pwrite && (in_paddr[3:0] == 4'h0);
+
+  assign in_prdata = (apb_rd && !fifo_empty) ? {24'd0, fifo[r_ptr]} : 32'd0;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      w_ptr    <= 3'd0;
+      r_ptr    <= 3'd0;
+      overflow <= 1'b0;
+    end else if (apb_rd && !fifo_empty) begin
+      r_ptr <= r_ptr + 3'd1;
+    end
+  end
+
 endmodule
+
diff --git a/perip/psram/efabless/EF_PSRAM_CTRL.v b/perip/psram/efabless/EF_PSRAM_CTRL.v
