-class bitrevChisel extends RawModule { // we do not need clock and reset
+class bitrevChisel extends RawModule {
   val io = IO(Flipped(new SPIIO(1)))
-  io.miso := true.B
+
+  // === SPI Slave: all registers on SCK posedge ===
+  //
+  // The SPI master's pos_edge/neg_edge pulses fire ONE system-clock cycle
+  // BEFORE the actual SCK edge.  With TX_NEGEDGE=1 (MOSI changes at neg_edge):
+  //   - Initial MOSI is set before any SCK edge and is stable at the first
+  //     SCK posedge (the first neg_edge hasn't fired yet)
+  //   - Each subsequent MOSI bit is set at neg_edge (one cycle before SCK
+  //     falls) and is stable by the next SCK posedge
+  //
+  // Using SCK posedge for everything:
+  //   - Captures MOSI correctly (stable at each posedge)
+  //   - MISO updates at SCK posedge, master samples at next pos_edge
+  //     (3 sys-clock cycles later) — perfectly stable
+
+  withClockAndReset(io.sck.asClock, io.ss(0).asAsyncReset) {
+    val shift_reg = RegInit(0.U(8.W))   // input shift register (MSB first)
+    val out_reg   = RegInit(0.U(8.W))   // output register
+    val bit_cnt   = RegInit(0.U(4.W))   // bit counter
+
+    // Shift in MOSI from the right (first bit → shift_reg[7] after 8 captures)
+    shift_reg := Cat(shift_reg(6, 0), io.mosi)
+
+    // At bit_cnt=7 (8th posedge): old shift_reg has 7 bits, io.mosi
+    // carries the 8th bit — together they form the complete input byte.
+    // Load the bit-reversed result into out_reg.
+    when (bit_cnt === 7.U) {
+      out_reg := Reverse(Cat(shift_reg(6, 0), io.mosi))
+    }
+    // After loading, shift out_reg left each cycle to present successive
+    // bits MSB-first on MISO.
+    when (bit_cnt >= 8.U) {
+      out_reg := Cat(out_reg(6, 0), 0.U(1.W))
+    }
+
+    bit_cnt := bit_cnt + 1.U
+
+    // MISO: idle=1 during input (bit_cnt < 8), output reversed data MSB first
+    io.miso := Mux(bit_cnt < 8.U, true.B, out_reg(7))
+  }
 }
diff --git a/src/device/CLINT.scala b/src/device/CLINT.scala
new file mode 100644
index 00000000..cccaa97c
--- /dev/null
+++ b/src/device/CLINT.scala
@@ -0,0 +1,62 @@
+package ysyx
+
+import chisel3._
+import chisel3.util._
+
+import freechips.rocketchip.amba.axi4._
+import org.chipsalliance.cde.config.Parameters
+import freechips.rocketchip.diplomacy._
+import freechips.rocketchip.util._
+
+class AXI4CLINT(address: Seq[AddressSet])(implicit p: Parameters) extends LazyModule {
+  val node = AXI4SlaveNode(Seq(AXI4SlavePortParameters(
+    slaves = Seq(AXI4SlaveParameters(
+      address       = address,
+      executable    = false,
+      supportsRead  = TransferSizes(1, 4),
+      supportsWrite = TransferSizes.none
+    )),
+    beatBytes = 4
+  )))
+  lazy val module = new Impl
+  class Impl extends LazyModuleImp(this) {
+    val (in, _) = node.in(0)
+    
+    val mtime = RegInit(0.U(64.W))
+    val mtimecmp = RegInit(0.U(64.W))
+    
+    mtime := mtime + 1.U
+    
+    val mtip = IO(Output(Bool()))
+    mtip := mtime >= mtimecmp
+    
+    // AXI4 Read
+    val ar_ready = RegInit(true.B)
+    val r_valid = RegInit(false.B)
+    val r_data = RegInit(0.U(64.W))
+    val r_id = RegInit(0.U(in.ar.bits.id.getWidth.W))
+    
+    in.ar.ready := ar_ready
+    when(in.ar.fire) {
+      ar_ready := false.B
+      r_valid := true.B
+      r_id := in.ar.bits.id
+      val addr = in.ar.bits.addr(15, 0)
+      r_data := MuxLookup(addr, 0.U)(Seq(
+        0x0000.U -> 0.U,       // msip (not implemented)
+        0x4000.U -> mtimecmp,
+        0xbff8.U -> mtime
+      ))
+    }
+    when(in.r.fire) {
+      ar_ready := true.B
+      r_valid := false.B
+    }
+    
+    in.r.valid := r_valid
+    in.r.bits.data := r_data
+    in.r.bits.id := r_id
+    in.r.bits.resp := 0.U
+    in.r.bits.last := true.B
+  }
+}
