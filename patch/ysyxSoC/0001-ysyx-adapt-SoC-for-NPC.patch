+          // ASS=0 IE=1 LSB=0 TXNEG=1 RXNEG=0 GO=1 res=0 CHAR_LEN=64
+          xip_wb_dat_i <= {18'd0, 1'b0, 1'b1, 1'b0, 1'b1, 1'b0, 1'b1, 1'b0, 7'd64};
