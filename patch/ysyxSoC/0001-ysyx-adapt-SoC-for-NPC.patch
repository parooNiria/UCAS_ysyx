diff --git a/perip/sdram/sdram.v b/perip/sdram/sdram.v
index 3613b231..59d7cc62 100644
--- a/perip/sdram/sdram.v
+++ b/perip/sdram/sdram.v
@@ -1,16 +1,249 @@
-module sdram(
-  input        clk,
-  input        cke,
-  input        cs,
-  input        ras,
-  input        cas,
-  input        we,
-  input [12:0] a,
