+//-----------------------------------------------------------------
+// MT48LC16M16A2 SDRAM Behavioral Simulation Model (DPI-C backed)
+//
+// Organization: 4 banks x 8192 rows x 512 cols x 16 bits = 256Mb
+//
+// Supported commands:
+//   ACTIVE, READ, WRITE, LOAD MODE REGISTER
+//   PRECHARGE → clears bank active flag
+//   AUTO REFRESH, BURST TERMINATE → NOP
+//
+// Mode Register fields used:
+//   A[6:4] = CAS Latency (010=CL2, 011=CL3)
+//   A[2:0] = Burst Length (001=2, 010=4, 011=8)
+//
+// Read pipeline: counter-based, adapts to CAS latency automatically
+//   CL=2: READ cmd(T0) → wait 1 cycle → data on DQ(T2)
+//   CL=3: READ cmd(T0) → wait 2 cycles → data on DQ(T3)
+//
+// Storage: DPI-C calls into C++ simulation environment
+//-----------------------------------------------------------------
+
+module sdram #(
+  parameter CHIP_ID = 0     // 0=lower 16 bits, 1=upper 16 bits of 32-bit DPI word
+) (
+  input         clk,       // SDRAM clock (= ~sys_clk from controller)
+  input         cke,       // Clock enable
+  input         cs,        // Chip select (active low)
+  input         ras,       // Row address strobe (active low)
+  input         cas,       // Column address strobe (active low)
+  input         we,        // Write enable (active low)
+  input  [12:0] a,         // Address (row / column multiplexed)
+  input  [ 1:0] ba,        // Bank address
+  input  [ 1:0] dqm,       // Data mask (active high per byte)
+  inout  [15:0] dq          // Data bus
 );
 
-  assign dq = 16'bz;
+  // DPI-C: memory storage in C++
+  import "DPI-C" function void sdram_dpi_read (input int addr, output int data);
+  import "DPI-C" function void sdram_dpi_write(input int addr, input int data, input int mask);
+
+  //-----------------------------------------------------------------
+  // Parameters
+  //-----------------------------------------------------------------
+  localparam ROW_W  = 13;   // 8192 rows
+  localparam COL_W  = 9;    // 512 columns
+  localparam BANK_W = 2;    // 4 banks
+
+  // SDRAM commands: {CS#, RAS#, CAS#, WE#} — all active low
+  localparam CMD_LMR  = 4'b0000;  // Load Mode Register
+  localparam CMD_AREF = 4'b0001;  // Auto Refresh → NOP
+  localparam CMD_PRE  = 4'b0010;  // Precharge
+  localparam CMD_ACT  = 4'b0011;  // Bank Activate
+  localparam CMD_WR   = 4'b0100;  // Write
+  localparam CMD_RD   = 4'b0101;  // Read
+  localparam CMD_BST  = 4'b0110;  // Burst Terminate → NOP
+  localparam CMD_NOP  = 4'b0111;  // No Operation
+
+  wire [3:0] cmd;
+  assign cmd = {cs, ras, cas, we};
+
+  //-----------------------------------------------------------------
+  // Mode Register — loaded by CMD_LMR
+  //-----------------------------------------------------------------
+  reg [2:0] mode_cl;     // CAS latency: 010=CL2, 011=CL3
+  reg [2:0] mode_bl;     // Burst length: 001=2, 010=4, 011=8
+
+  // Burst length → number of 16-bit beats
+  wire [3:0] bl_beats;
+  assign bl_beats = (mode_bl == 3'b000) ? 4'd1 :
+                    (mode_bl == 3'b001) ? 4'd2 :
+                    (mode_bl == 3'b010) ? 4'd4 :
+                    (mode_bl == 3'b011) ? 4'd8 : 4'd1;
+  //-----------------------------------------------------------------
+  // Bank state — one open row per bank
+  //-----------------------------------------------------------------
+  reg                ba_act [0:3];   // bank[i] is active?
+  reg [ROW_W-1:0]    ba_row [0:3];   // active row in bank[i]
+
+  //-----------------------------------------------------------------
+  // Read state — counter-based pipeline
+  //   rd_active=1, rd_delay=N → wait N cycles → output data
+  //-----------------------------------------------------------------
+  reg                rd_active;      // read burst in progress
+  reg [3:0]          rd_delay;       // remaining wait cycles before data
+  reg [COL_W-1:0]    rd_col;         // current column address
+  reg [BANK_W-1:0]   rd_ba;          // target bank
+  reg [3:0]          rd_rem;         // remaining burst beats
+
+  //-----------------------------------------------------------------
+  // Write burst state — continuation after CMD_WR
+  //-----------------------------------------------------------------
+  reg                wr_active;      // write burst in progress
+  reg [COL_W-1:0]    wr_col;         // next column address
+  reg [BANK_W-1:0]   wr_ba;          // target bank
+  reg [3:0]          wr_rem;         // remaining burst beats
+
+  //-----------------------------------------------------------------
+  // DQ tristate output
+  //-----------------------------------------------------------------
+  wire [15:0] dq_out;
+  wire        dq_oe;
+  assign dq = dq_oe ? dq_out : 16'bz;
+  reg [31:0] rdata;
+ 
+  always @(*) begin
+    if (rd_active && rd_delay == 4'd0) begin
+      if(CHIP_ID == 0)
+        sdram_dpi_read({7'd0, faddr(rd_ba, ba_row[rd_ba], rd_col),1'b0}, rdata);
+      else
+         sdram_dpi_read({7'd0, faddr(rd_ba, ba_row[rd_ba], rd_col),1'b1}, rdata);
+    end
+    else
+      rdata = 32'h0;
+  end
+
+  // CHIP_ID=0 → lower 16 bits; CHIP_ID=1 → upper 16 bits of the 32-bit DPI word
+  assign dq_out = rdata[15:0];
+  assign dq_oe = rd_active && rd_delay == 4'd0;
+  //-----------------------------------------------------------------
+  // Flat address builder: {bank[1:0], row[12:0], col[8:0]} = 24 bits
+  //-----------------------------------------------------------------
+  function [23:0] faddr;
+    input [BANK_W-1:0] b;
+    input [ROW_W-1:0]  r;
+    input [COL_W-1:0]  c;
+    begin
+      faddr = {r,b, c};
+    end
+  endfunction
+
+  //-----------------------------------------------------------------
+  // DPI argument registers (32-bit to match DPI-C int type)
+  //-----------------------------------------------------------------
+  wire [31:0] host_addr;
+  wire [31:0] host_wdata;
+  wire [31:0] host_rdata;
+  wire[31:0] host_mask;
+
+  //-----------------------------------------------------------------
+  // Main logic
+  //-----------------------------------------------------------------
+  always @(posedge clk) begin
+    
+    if(rd_active) begin
+      if (rd_delay > 4'd0) begin
+        rd_delay <= rd_delay - 4'd1;
+      end else begin
+        rd_rem <= rd_rem - 4'd1;
+        rd_col <= rd_col + 1'b1;
+        if (rd_rem == 4'd1) rd_active <= 1'b0;
+      end
+    end
+
+    //===============================================================
+    // Command execution (CKE=1, CS#=0)
+    //===============================================================
+    if (cke && !cs) begin
+      case (cmd)
+
+        CMD_NOP, CMD_BST: ;   // nothing to do
+
+        //----- Load Mode Register -----
+        CMD_LMR: begin
+          mode_cl <= a[6:4];
+          mode_bl <= a[2:0];
+        end
+
+        //----- Auto Refresh (NOP) -----
+        CMD_AREF: ;
+
+        //----- Precharge: close row(s) -----
+        CMD_PRE: begin
+          if (a[10]) begin
+            ba_act[0] <= 1'b0; ba_act[1] <= 1'b0;
+            ba_act[2] <= 1'b0; ba_act[3] <= 1'b0;
+          end else begin
+            ba_act[ba] <= 1'b0;
+          end
+        end
+
+        //----- Bank Activate: open a row -----
+        CMD_ACT: begin
+          ba_row[ba] <= a[ROW_W-1:0];
+          ba_act[ba] <= 1'b1;
+        end
+
+        //----- Read: start pipeline -----
+        CMD_RD: begin
+          if (ba_act[ba]) begin
+            rd_active <= 1'b1;
+            rd_delay  <= {1'b0, mode_cl} - 4'd1;    // CL-1 dead cycles
+            rd_col    <= a[COL_W-1:0];
+            rd_ba     <= ba;
+            rd_rem    <= bl_beats;
+          end
+        end
+
+        //----- Write: first beat on DQ now -----
+        CMD_WR: begin
+          if (ba_act[ba]) begin
+            if (CHIP_ID == 0)
+              sdram_dpi_write({7'd0, faddr(ba, ba_row[ba], a[COL_W-1:0]),1'b0},
+                              {16'd0, dq}, {30'd0, dqm});
+            else
+              sdram_dpi_write({7'd0, faddr(ba, ba_row[ba], a[COL_W-1:0]),1'b1},
+                              {16'd0, dq}, {30'd0, dqm});
+            // remaining beats via burst continuation
+            if (bl_beats > 1) begin
+              wr_active <= 1'b1;
+              wr_col    <= a[COL_W-1:0] + 1'b1;
+              wr_ba     <= ba;
+              wr_rem    <= bl_beats - 4'd1;
+            end
+          end
+        end
+
+        default: ;
+      endcase
+    end
+
+    //===============================================================
+    // Write burst continuation (subsequent beats on NOP cycles)
+    //===============================================================
+    if (cke && wr_active) begin
+            if (CHIP_ID == 0)
+              sdram_dpi_write({7'd0, faddr(wr_ba, ba_row[wr_ba], wr_col),1'b0},
+                              {16'd0, dq}, {30'd0, dqm});
+            else
+              sdram_dpi_write({7'd0, faddr(wr_ba, ba_row[wr_ba], wr_col),1'b1},
+                              {16'd0, dq}, {30'd0, dqm});
+      wr_col <= wr_col + 1'b1;
+      wr_rem <= wr_rem - 4'd1;
+      if (wr_rem == 4'd1) wr_active <= 1'b0;
+    end
+  end
+
+  //-----------------------------------------------------------------
+  // Initialization
+  //-----------------------------------------------------------------
+  integer gi;
+  initial begin
+    mode_cl   = 3'b010;    // default CL=2 (matches controller)
+    mode_bl   = 3'b000;    // default BL=2 (matches controller)
+    for (gi = 0; gi < 4; gi = gi + 1) ba_act[gi] = 1'b0;
+    rd_active = 1'b0;
+    wr_active = 1'b0;
+  end
 
 endmodule
diff --git a/perip/sdram/sdram_32.v b/perip/sdram/sdram_32.v
