+//-----------------------------------------------------------------
+// VGA Controller — 640×480 @ 60Hz, 24-bit color (RGB 8:8:8)
+// Frame buffer: DPI-C (C++ side manages 640×480×32-bit storage)
+// Pixel clock: sys_clk / 4 ≈ 25MHz
+//
+// VGA timing (800×525 @ 25MHz):
+//   h_total=800  h_sync=96  h_back=48  h_active=640  h_front=16
+//   v_total=525  v_sync=2   v_back=33  v_active=480  v_front=10
+//
+// DPI-C functions (implemented in C++):
+//   void vga_fb_write(int addr, int data) — APB write by linear index
+//   int  vga_fb_read (int addr)          — APB read by linear index
+//   int  vga_fb_pixel(int x, int y)      — VGA display read by coordinates
+//-----------------------------------------------------------------
+
 module vga_top_apb(
   input         clock,
   input         reset,
@@ -20,4 +35,95 @@ module vga_top_apb(
   output        vga_valid
 );
 
+  import "DPI-C" function void vga_fb_write(input int addr, input int data);
+  import "DPI-C" function int  vga_fb_read (input int addr);
+  import "DPI-C" function int  vga_fb_pixel(input int x, input int y);
+
+  localparam H_ACTIVE  = 640;
+  localparam V_ACTIVE  = 480;
+  localparam FB_SIZE   = 307200;
+
+  assign in_pready  = 1'b1;
+  assign in_pslverr = 1'b0;
+
+  //-----------------------------------------------------------------
+  // APB → DPI-C frame buffer write / read
+  //-----------------------------------------------------------------
+  wire        apb_wr = in_psel && in_penable && in_pwrite;
+  wire        apb_rd = in_psel && in_penable && !in_pwrite;
+  wire [18:0] pix_idx = in_paddr[20:2];
+
+  always @(posedge clock) begin
+    if (apb_wr && pix_idx < FB_SIZE)
+      vga_fb_write({13'b0,pix_idx}, in_pwdata);
+  end
+
+  assign in_prdata = (apb_rd && pix_idx < FB_SIZE) ? vga_fb_read({13'b0,pix_idx}) : 32'd0;
+
+  //-----------------------------------------------------------------
+  // VGA timing (25MHz pixel clock = sys_clock / 4)
+  //-----------------------------------------------------------------
+  localparam H_TOTAL  = 800;
+  localparam H_SYNC   = 96;
+  localparam H_BACK   = 48;
+  localparam H_BLANK  = H_SYNC + H_BACK;
+
+  localparam V_TOTAL  = 525;
+  localparam V_SYNC   = 2;
+  localparam V_BACK   = 33;
+  localparam V_BLANK  = V_SYNC + V_BACK;
+
+  reg [9:0] h_cnt;
+  reg [9:0] v_cnt;
+
+  always @(posedge clock) begin
+    if (reset) begin
+      h_cnt <= 10'd0;
+      v_cnt <= 10'd0;
+    end else begin
+      if (h_cnt == H_TOTAL - 1) begin
+        h_cnt <= 10'd0;
+        if (v_cnt == V_TOTAL - 1)
+          v_cnt <= 10'd0;
+        else
+          v_cnt <= v_cnt + 10'd1;
+      end else begin
+        h_cnt <= h_cnt + 10'd1;
+      end
+    end
+  end
+
+  wire h_active = (h_cnt >= H_BLANK) && (h_cnt < H_BLANK + H_ACTIVE);
+  wire v_active = (v_cnt >= V_BLANK) && (v_cnt < V_BLANK + V_ACTIVE);
+
+  assign vga_hsync = (h_cnt >= H_SYNC);
+  assign vga_vsync = (v_cnt >= V_SYNC);
+
+  wire [9:0] x = h_cnt - H_BLANK;
+  wire [9:0] y = v_cnt - V_BLANK;
+
+  wire [31:0] fb_word = vga_fb_pixel({22'b0,x}, {22'b0,y});
+
+  reg [7:0] r_out, g_out, b_out;
+  reg       valid_out;
+
+  always @(posedge clock) begin
+    if (h_active && v_active) begin
+      r_out     <= fb_word[23:16];
+      g_out     <= fb_word[15:8];
+      b_out     <= fb_word[7:0];
+      valid_out <= 1'b1;
+    end else begin
+      r_out     <= 8'd0;
+      g_out     <= 8'd0;
+      b_out     <= 8'd0;
+      valid_out <= 1'b0;
+    end
+  end
+
+  assign vga_r     = r_out;
+  assign vga_g     = g_out;
+  assign vga_b     = b_out;
+  assign vga_valid = valid_out;
+
 endmodule
