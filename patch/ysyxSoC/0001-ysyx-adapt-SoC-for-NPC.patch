+++ b/perip/sdram/sdram_32.v
@@ -0,0 +1,50 @@
+//-----------------------------------------------------------------
+// sdram_32 — 32-bit SDRAM wrapper using 2 × 16-bit MT48LC16M16A2
+//
+// Two 16-bit chips in parallel for bit-extension:
+//   chip0: dq[15:0],  dqm[1:0]
+//   chip1: dq[31:16], dqm[3:2]
+//
+// All command/address/control signals are shared between the two chips.
+//-----------------------------------------------------------------
+
+module sdram_32(
+  input         clk,
+  input         cke,
+  input         cs,
+  input         ras,
+  input         cas,
+  input         we,
+  input  [12:0] a,
+  input  [ 1:0] ba,
+  input  [ 3:0] dqm,
+  inout  [31:0] dq
+);
+
+  sdram #(.CHIP_ID(0)) chip0 (
+    .clk (clk),
+    .cke (cke),
+    .cs  (cs),
+    .ras (ras),
+    .cas (cas),
+    .we  (we),
+    .a   (a),
+    .ba  (ba),
+    .dqm (dqm[1:0]),
+    .dq  (dq[15:0])
+  );
+
+  sdram #(.CHIP_ID(1)) chip1 (
+    .clk (clk),
+    .cke (cke),
+    .cs  (cs),
+    .ras (ras),
+    .cas (cas),
+    .we  (we),
+    .a   (a),
+    .ba  (ba),
+    .dqm (dqm[3:2]),
+    .dq  (dq[31:16])
+  );
+
+endmodule
