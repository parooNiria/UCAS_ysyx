@@ -112,6 +112,7 @@ module PSRAM_READER (
             //saddr <= {addr[23:2], 2'b0};
             saddr <= {addr[23:0]};
 
+    //8个周期的cmd，6个周期的地址，6个周期的dummy，8个周期的数据
     // Sample with the negedge of sck
     wire[1:0] byte_index = {counter[7:1] - 8'd10}[1:0];
     always @ (posedge clk)
diff --git a/perip/psram/psram.v b/perip/psram/psram.v
index d9bdd882..da981bb5 100644
--- a/perip/psram/psram.v
+++ b/perip/psram/psram.v
@@ -1,9 +1,148 @@
-module psram(
-  input sck,
-  input ce_n,
-  inout [3:0] dio
+// IS66WVS4M8ALL PSRAM behavioral model
+// Supports Quad IO Read (EBh) and Quad IO Write (38h) in SPI Mode.
+// Storage array accessed via DPI-C.
+
+module psram (
+  input         sck,
+  input         ce_n,
+  inout  [3:0]  dio
 );
 
-  assign dio = 4'bz;
+  import "DPI-C" function void psram_read (input int addr, output int data);
+  import "DPI-C" function void psram_write(input int addr, input int data, input int mask);
+
+  wire reset = ce_n;
+  // -------------------------------------------------------------------------
+  // SCK cycle counter
+  // -------------------------------------------------------------------------
+  reg [7:0] cnt;
+  always @(posedge sck or posedge reset) begin
+    if (reset) cnt <= 8'd0;
+    else       cnt <= cnt + 8'd1;
+  end
+
+  // -------------------------------------------------------------------------
+  // Command sampling: 1-bit per SCK, MSB first (cnt = 0 .. 7)
+  // -------------------------------------------------------------------------
+  reg [7:0] cmd;
+  always @(posedge sck or posedge reset) begin
+    if (reset) cmd <= 8'd0;
+    else if (cnt < 8) cmd <= {cmd[6:0], dio[0]};
+  end
+
+  // -------------------------------------------------------------------------
+  // Address sampling: 4-bit per SCK (cnt = 8 .. 13)
+  // -------------------------------------------------------------------------
+  reg [23:0] addr;
+  always @(posedge sck or posedge reset) begin
+    if (reset) addr <= 24'd0;
+    else if (cnt >= 8 && cnt < 14) addr <= {addr[19:0], dio};
+  end
+
+  // -------------------------------------------------------------------------
+  // EBh — Quad IO Read (1-4-4)
+  //   cnt 0..7  : command  (1-bit)
+  //   cnt 8..13 : address  (4-bit / SCK)
+  //   cnt 14..19: dummy cycles (6 SCK), bus released
+  //   cnt 20..27: data     (4-bit / SCK), PSRAM drives bus
+  //
+  //   PSRAM drives data on SCK falling edge.
+  //   rd_shift loads at negedge cnt==19, dout ready for SCK 20.
+  // -------------------------------------------------------------------------
+
+  // Trigger DPI read at end of dummy cycles (posedge sck, cnt == 19)
+  reg [31:0] rdata_reg;
+  always @(posedge sck or posedge reset) begin
+    if (reset) rdata_reg <= 32'd0;
+    else if (cnt == 19 && cmd == 8'hEB) psram_read({8'd0, addr}, rdata_reg);
+  end
+
+  // Read shift register — updated on negedge sck.
+  // rdata_reg from DPI-C is little-endian: [7:0]=byte0, [15:8]=byte1...
+  // Byte-swap so byte0 goes to [31:28] and shifts out first.
+  reg [31:0] rd_shift;
+  always @(negedge sck or posedge reset) begin
+    if (reset) begin
+      rd_shift <= 32'd0;
+    end else if (cnt == 20 && cmd == 8'hEB) begin
+      rd_shift <= {rdata_reg[7:0], rdata_reg[15:8], rdata_reg[23:16], rdata_reg[31:24]};
+    end else if (cnt >= 21 && cmd == 8'hEB) begin
+      rd_shift <= {rd_shift[27:0], 4'b0};
+    end
+  end
+
+  // Tri-state control: drive bus during data phase (SCK 20..27)
+  reg douten;
+  always @(negedge sck or posedge reset) begin
+    if (reset) douten <= 1'b0;
+    else if (cnt >= 20 && cnt < 28 && cmd == 8'hEB) douten <= 1'b1;
+    else douten <= 1'b0;
+  end
+
+  wire [3:0] dout = rd_shift[31:28];
+
+  // -------------------------------------------------------------------------
+  // 38h — Quad IO Write (1-4-4)
+  //   cnt 0..7  : command  (1-bit)
+  //   cnt 8..13 : address  (4-bit / SCK)
+  //   cnt 14..N : data     (4-bit / SCK), N depends on write size
+  //
+  //   Controller sends bytes in order: byte0, byte1, byte2, byte3.
+  //   wd[7:0]=byte0, wd[15:8]=byte1... — already little-endian.
+  //   Write triggered on ce_n rising edge (posedge reset).
+  // -------------------------------------------------------------------------
+
+  // Write data shift register: shifts in 4-bit nibbles from LSB.
+  // Controller sends: cnt=14→line[7:4], cnt=15→line[3:0],
+  //   cnt=16→line[15:12], cnt=17→line[11:8], ...
+  // {wd[27:0], dio} shifts existing nibbles left, inserts new at [3:0].
+  // After 2N SCK: wd[(N*8-1):0] = {byteN-1, ..., byte0} (little-endian).
+  reg [31:0] wd;
+  always @(posedge sck or posedge reset) begin
+    if (reset)
+      wd <= 32'd0;
+    else if (cnt >= 14 && cmd == 8'h38)
+      wd <= {wd[27:0], dio};
+  end
+
+  // Trigger DPI write at end of transaction (ce_n rising).
+  // cnt at reset = last SCK index. nibbles = cnt - 13, bytes = nibbles / 2.
+  // wd is little-endian, passed as-is to DPI-C.
+  wire [7:0] wtype;
+  assign wtype = ((cnt - 8'd14) >> 1) ;
+  wire [3:0] wmask_type ;
+  assign wmask_type = (wtype == 1) ? (
+      (addr[1:0] == 2'b00) ? 4'b0001 :
+      (addr[1:0] == 2'b01) ? 4'b0010 :
+      (addr[1:0] == 2'b10) ? 4'b0100 :
+      4'b1000
+  ) : (
+      (wtype == 2) ? (
+          (addr[1] == 1'b0) ? 4'b0011 : 4'b1100
+      ) : (
+          (wtype == 4) ? 4'b1111 : 4'b0000
+      )
+  );
+  wire [31:0] wdata;
+  assign wdata = (wtype == 1) ? {4{wd[7:0]}} :
+                  (wtype == 2) ? {2{wd[7:0], wd[15:8]}} :
+                  (wtype == 4) ? {wd[7:0], wd[15:8], wd[23:16], wd[31:24]} :
+                  32'd0;
+
+  always @(posedge sck or posedge reset) begin
+    if (reset) begin
+      if (cmd == 8'h38 && cnt >= 15) begin
+        psram_write({8'd0, addr}, wdata, {28'd0,wmask_type});
+      end
+    end
+  end
+
+  // -------------------------------------------------------------------------
+  // Tri-state I/O
+  // -------------------------------------------------------------------------
+  assign dio[0] = douten ? dout[0] : 1'bz;
+  assign dio[1] = douten ? dout[1] : 1'bz;
+  assign dio[2] = douten ? dout[2] : 1'bz;
+  assign dio[3] = douten ? dout[3] : 1'bz;
 
 endmodule
