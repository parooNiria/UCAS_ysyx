+          xip_wb_we    <= 1'b0;
+          xip_wb_stb   <= 1'b1;
+          xip_wb_cyc   <= 1'b1;
+          xip_state    <= XIP_READ;
+        end
+      end
+
+      XIP_READ: begin
+        if (wb_ack) begin
+          xip_wb_stb   <= 1'b0;
+          xip_wb_cyc   <= 1'b0;
+          xip_rdata    <= {wb_dat_o[7:0], wb_dat_o[15:8],
+                           wb_dat_o[23:16], wb_dat_o[31:24]};
+          xip_done     <= 1'b1;
+          xip_state    <= XIP_IDLE;
+        end
+      end
+
+      default: xip_state <= XIP_IDLE;
+    endcase
+  end
+end
+
+// ================================================================
+// Wishbone bus mux: APB (normal access) vs XIP state machine
+// ================================================================
+// Block APB→Wishbone passthrough as soon as a flash read is detected,
+// so the APB request doesn't leak through as a spurious SPI read before
+// the XIP state machine enters WR_DIV.
+wire xip_trigger = (xip_state == XIP_IDLE) && in_psel && in_penable && !in_pwrite && is_flash;
+wire in_xip = (xip_state != XIP_IDLE) || xip_trigger;
+
+assign wb_adr   = in_xip ? xip_wb_adr   : in_paddr[4:0];
+assign wb_dat_i = in_xip ? xip_wb_dat_i : in_pwdata;
+assign wb_sel   = in_xip ? 4'hF         : in_pstrb;
+assign wb_we    = in_xip ? xip_wb_we    : in_pwrite;
+assign wb_stb   = in_xip ? xip_wb_stb   : in_psel;
+assign wb_cyc   = in_xip ? xip_wb_cyc   : in_penable;
+
+// ================================================================
+// APB response
+// ================================================================
+// Normal SPI access: pready follows wb_ack
+// XIP access:       pready is a 1-cycle pulse when XIP_READ completes
+// Flash write:      pready=1, pslverr=1 (error response)
+wire flash_write = is_flash && in_pwrite && in_psel && in_penable && !in_xip;
+
+assign in_pready  = flash_write ? 1'b1 :
+                    in_xip     ? xip_done :
+                                 wb_ack;
+assign in_prdata  = in_xip ? xip_rdata : wb_dat_o;
+
+// Report error on flash writes
+always @(posedge clock) begin
+  if (flash_write) begin
+    $fwrite(32'h80000002,
+            "[XIP ERROR] Write to flash address space detected! paddr=0x%08x, pwdata=0x%08x\n",
+            in_paddr, in_pwdata);
+  end
+end
+
 `endif // FAST_FLASH
 
 endmodule
